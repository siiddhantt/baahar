{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baahar.app/contracts/source-manifest.schema.json",
  "title": "Baahar source manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "display_name",
    "city",
    "canonical_hosts",
    "official_url",
    "collector_id",
    "output_schema",
    "publication_state",
    "collection_state",
    "schedule",
    "freshness_ttl",
    "collection_input",
    "limits",
    "health",
    "identity"
  ],
  "properties": {
    "schema_version": { "const": "source-manifest/v1" },
    "source": { "$ref": "#/$defs/slug" },
    "source_id": { "type": "string", "format": "uuid" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "city": { "$ref": "#/$defs/slug" },
    "city_id": { "type": "string", "format": "uuid" },
    "canonical_hosts": { "$ref": "#/$defs/hosts" },
    "registration_hosts": { "$ref": "#/$defs/hosts" },
    "image_hosts": { "$ref": "#/$defs/hosts" },
    "official_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "collector_id": {
      "type": ["string", "null"],
      "pattern": "^c_[A-Za-z0-9_-]+$"
    },
    "output_schema": { "const": "event-occurrence/v1" },
    "publication_state": { "enum": ["active", "preview"] },
    "collection_state": { "enum": ["verified", "local_verified", "blocked"] },
    "worker_type": { "enum": ["code", "browser"] },
    "blocked_reason": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "schedule": {
      "type": "string",
      "pattern": "^(?:[0-5]?[0-9]) \\*/(?:1|2|3|4|6|8|12|24) \\* \\* \\*$"
    },
    "freshness_ttl": { "type": "string", "pattern": "^[1-9][0-9]*h$" },
    "collection_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pages_per_run", "records_per_run"],
      "properties": {
        "pages_per_run": { "type": "integer", "minimum": 1, "maximum": 500 },
        "records_per_run": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "window_days": { "type": "integer", "minimum": 1, "maximum": 366 },
        "browser_navigations_per_run": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "browser_actions_per_run": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "browser_fanout_per_run": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "maximum_physical_requests_in_live_preflight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_records",
        "maximum_parse_error_ratio",
        "maximum_duplicate_ratio",
        "missing_observations_before_removal",
        "low_count_ratio_after_baseline",
        "high_count_ratio_after_baseline"
      ],
      "properties": {
        "minimum_records": { "type": "integer", "minimum": 0 },
        "maximum_parse_error_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "multipleOf": 0.0001
        },
        "maximum_duplicate_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "multipleOf": 0.0001
        },
        "missing_observations_before_removal": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        },
        "low_count_ratio_after_baseline": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "multipleOf": 0.0001
        },
        "high_count_ratio_after_baseline": {
          "type": "number",
          "minimum": 1,
          "maximum": 10,
          "multipleOf": 0.0001
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_event_id"],
      "properties": {
        "source_event_id": { "type": ["string", "null"] },
        "source_event_id_pattern": { "type": "string", "minLength": 1 },
        "stable_when_time_changes": { "type": "boolean" },
        "fallback_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "array_position_allowed": { "type": "boolean" },
        "exact_duplicates_allowed": { "type": "boolean" },
        "multi_performance_requirement": { "type": "string" }
      }
    },
    "image_preference": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "category_map": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "arts",
          "talks",
          "theatre",
          "music",
          "books",
          "community",
          "other"
        ]
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["robots_status", "pages_per_run", "facts_only"],
      "properties": {
        "robots_status": {
          "enum": ["allow", "allow_public_page", "missing_404"]
        },
        "pages_per_run": { "type": "integer", "minimum": 1, "maximum": 500 },
        "facts_only": { "const": true }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "publication_state": { "const": "active" } },
        "required": ["publication_state"]
      },
      "then": {
        "required": [
          "source_id",
          "display_name",
          "city_id",
          "official_url",
          "collector_id",
          "collection_state",
          "collection_input"
        ]
      }
    },
    {
      "if": {
        "properties": { "collector_id": { "type": "string" } },
        "required": ["collector_id"]
      },
      "then": { "required": ["source_id", "city_id"] }
    },
    {
      "if": {
        "properties": { "collection_state": { "const": "blocked" } },
        "required": ["collection_state"]
      },
      "then": { "required": ["blocked_reason"] }
    }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "hostname",
        "pattern": "^[a-z0-9.-]+$"
      }
    }
  }
}
