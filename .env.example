BAAHAR_OBJECT_REGION=us-east-1
BAAHAR_OBJECT_BUCKET=baahar-artifacts
BAAHAR_OBJECT_ACCESS_KEY=baahar
BAAHAR_OBJECT_SECRET_KEY=replace-me
BAAHAR_OBJECT_PATH_STYLE=true

# Browser application
